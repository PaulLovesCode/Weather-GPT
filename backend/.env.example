# WeatherGPT Backend configuration
# Copy this file to `.env` and fill in real values.
# All values below are the local-development defaults.

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Comma-separated list of Gemini models to try, in order.
GEMINI_MODELS=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
GEMINI_TIMEOUT=45
MAX_GEMINI_CONCURRENCY=5

# ---------------------------------------------------------------------------
# HTTP timeouts (seconds) applied to every external request
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_CONNECT=15
HTTP_TIMEOUT_READ=30
HTTP_TIMEOUT_WRITE=15
HTTP_TIMEOUT_POOL=15

# Retries for transient failures (exponential backoff: 1s, 2s, 4s + jitter)
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE=1.0,2.0,4.0

# ---------------------------------------------------------------------------
# Rate limits per IP: N/unit where unit is second | minute | hour
# ---------------------------------------------------------------------------
RATE_LIMIT=30/minute
CURRENT_RATE_LIMIT=30/minute
WEATHER_RATE_LIMIT=30/minute
FORECAST_RATE_LIMIT=20/minute
CHAT_RATE_LIMIT=10/minute
GEOCODING_RATE_LIMIT=10/minute

# ---------------------------------------------------------------------------
# Cache TTLs (seconds). Coordinates are rounded to 4 decimals before keying.
# ---------------------------------------------------------------------------
WEATHER_CACHE_TTL=300
FORECAST_CACHE_TTL=900
HOURLY_CACHE_TTL=300
GEOCODING_CACHE_TTL=3600
CACHE_ROUND_PRECISION=4

# Serve stale cached data for up to this many seconds if provider is down.
STALE_CACHE_MAX_AGE=3600

# ---------------------------------------------------------------------------
# Nominatim / external providers
# ---------------------------------------------------------------------------
# Identifying User-Agent required by the Nominatim usage policy.
NOMINATIM_USER_AGENT=WeatherGPT/1.0 (https://github.com/weathergpt-app/weather-capstone)

# ---------------------------------------------------------------------------
# Chat request validation
# ---------------------------------------------------------------------------
MAX_CHAT_MESSAGE_LENGTH=4000
MAX_CHAT_HISTORY=20

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000